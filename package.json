{
  "name": "milladweb",
  "version": "1.0.0",
  "private": true,
  "description": "Millad's Supermarket - Grocery store website",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w server & npm run dev -w client",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build:app": "npm run build -w server && npm run build -w client",
    "build": "node scripts/vercel-build.js",
    "deploy:place-order": "supabase functions deploy place-order --no-verify-jwt",
    "serve": "npx serve frontend -l 3000",
    "export": "node scripts/export-products.js",
    "seed": "node scripts/seed-products.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2"
  },
  "devDependencies": {
    "csso-cli": "^4.0.2",
    "esbuild": "^0.28.0",
    "purgecss": "^8.0.0"
  }
}
