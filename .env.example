# ── App ───────────────────────────────────────────────────
STORE_ID=millads
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
STORE_NOTIFY_EMAIL=milladssupermarket@gmail.com

# Public values for the React app (anon key only; never the service role).
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Supabase ──────────────────────────────────────────────
# Used by Edge Functions (auto-injected by Supabase CLI) and Node scripts.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Node scripts use this alias for the service role key:
SUPABASE_SERVICE_KEY=your-service-role-key

# ── TechToStore Dashboard (optional) ─────────────────────
# Base URL used in invite-employee Edge Function emails.
# Defaults to https://app.techtostore.com if not set.
TTS_DASHBOARD_URL=https://app.techtostore.com
